# Copy to .env.local for local development. Set the same values in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Public site URL used for canonical URLs, sitemap and Open Graph (no trailing slash).
# If unset on Vercel, the production *.vercel.app URL is used automatically.
NEXT_PUBLIC_SITE_URL=

# WhatsApp number customers chat with via wa.me links (digits only, with country code). Default: 919913830802
NEXT_PUBLIC_WHATSAPP_NUMBER=919913830802

# --- Automatic owner notification (WhatsApp Business Platform / Meta Cloud API) ---
# Server-only. Leave blank until Meta setup is complete; the form then falls back to a prefilled WhatsApp message.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OWNER_RECIPIENT=919913830802
WHATSAPP_TEMPLATE_NAME=website_enquiry
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v24.0

# Local testing only (points the API at a mock server). Leave unset in production.
# WHATSAPP_GRAPH_BASE_URL=http://127.0.0.1:4010
